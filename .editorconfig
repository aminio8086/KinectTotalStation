root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
csharp_new_line_before_open_brace = all

[*.xaml]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{md,cff,yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{csproj,sln}]
indent_style = space
indent_size = 2
