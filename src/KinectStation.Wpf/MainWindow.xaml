<Window x:Class="KinectStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinect Station"
        Width="940"
        Height="610"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Width="512" Height="424">
            <Image x:Name="DepthImage"
                   Width="512"
                   Height="424"
                   Stretch="None"
                   MouseMove="DepthImage_MouseMove"
                   MouseLeftButtonDown="DepthImage_MouseLeftButtonDown"
                   MouseRightButtonDown="DepthImage_MouseRightButtonDown" />
            <Canvas x:Name="Overlay"
                    Width="512"
                    Height="424"
                    IsHitTestVisible="False" />
        </Grid>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Kinect Station"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16" />

            <TextBlock Text="Sensor status" FontWeight="Bold" />
            <TextBlock x:Name="StatusText"
                       Text="Initialising..."
                       Margin="0,2,0,14" />

            <TextBlock Text="Pointer" FontWeight="Bold" />
            <TextBlock x:Name="PointerText"
                       Text="Move over the depth image"
                       Margin="0,2,0,14" />

            <TextBlock Text="Selected points" FontWeight="Bold" />
            <TextBlock x:Name="PointsText"
                       Text="0 / 4"
                       Margin="0,2,0,14" />

            <TextBlock Text="Distance (m)" FontWeight="Bold" />
            <TextBlock x:Name="DistanceText"
                       Text="—"
                       Margin="0,2,0,10" />

            <TextBlock Text="Relative angle (degrees)" FontWeight="Bold" />
            <TextBlock x:Name="AngleText"
                       Text="—"
                       Margin="0,2,0,10" />

            <TextBlock Text="Perimeter (m)" FontWeight="Bold" />
            <TextBlock x:Name="PerimeterText"
                       Text="—"
                       Margin="0,2,0,10" />

            <TextBlock Text="Area (m²)" FontWeight="Bold" />
            <TextBlock x:Name="AreaText"
                       Text="—"
                       Margin="0,2,0,18" />

            <TextBlock TextWrapping="Wrap"
                       Foreground="DimGray"
                       Text="Left-click to select up to four points. Right-click to clear the current measurement." />
        </StackPanel>
    </Grid>
</Window>
